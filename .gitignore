# Visual Studio and .NET build output
.vs/
**/bin/
**/obj/
TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates

# Local credentials and environment files
.env
.env.*
!.env.example
*.key
*.p12
*.pfx

# Logs, diagnostics, and crash dumps
*.log
*.dmp
*.stackdump

# Generated reports and local analysis output
graphify-out/

# Generated release and publish artifacts
dist/
publish/
*.zip
*.msix
*.appx

# Windows packaging output is generated by dotnet publish.
# Keep only the launch scripts, README, and example environment file.
windows/packaging/*
!windows/packaging/*.bat
!windows/packaging/*.txt
!windows/packaging/.env.example

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp

# Local agent/instruction files
CLAUDE.md
AGENTS.md
